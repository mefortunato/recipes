# Copy to docker-compose.override.yml for live hot-reload of the backend in Docker
services:
  app:
    volumes:
      - ./backend/app:/app/app:ro
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

  # For frontend live-reloading, run 'npm run dev' in ./frontend (Vite proxies /api to the backend)
