# Copy to docker-compose.override.yml for live hot-reload development in Docker
services:
  backend:
    volumes:
      - ./backend/app:/app/app:ro
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

  # For frontend live-reloading, run 'npm run dev' locally or run dev container:
  # frontend:
  #   command: ["npm", "run", "dev", "--", "--host"]
