# ==============================================================
# RECIPE BOOK - ENVIRONMENT CONFIGURATION
# ==============================================================

# Application port (mapped on host for unified container)
PORT=8080

# MongoDB port (mapped on host)
MONGO_PORT=27017

# MongoDB connection string
# Local container: mongodb://mongodb:27017 (in Docker) or mongodb://127.0.0.1:27017 (on host)
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=recipe_book

# Application Environment (development, staging, production)
ENVIRONMENT=development
# Serve Swagger (/docs), ReDoc (/redoc) and /openapi.json. Defaults to on everywhere except production.
# API_DOCS_ENABLED=false

# Auto-seed sample recipes if collection is empty
AUTO_SEED=true

# Logging Configuration ('text' for local, 'json' for GCP Cloud Logging)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Public Frontend URL / Custom Domain (used for CORS and cloud deployments)
# For local dev: http://localhost:8080 or http://localhost:5173
# For production: https://YOUR_CUSTOM_DOMAIN.com (or set CUSTOM_DOMAIN=yourdomain.com)
FRONTEND_URL=http://localhost:8080
# CUSTOM_DOMAIN=

# ==============================================================
# GOOGLE CLOUD RUN DEPLOYMENT (Used by ./scripts/deploy-gcp.sh and setup-github-deploy.sh;
# GitHub Actions deploys read these from the "production" environment instead)
# ==============================================================
# GCP Project ID - env var ensures seamless workspace switching without gcloud config changes
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SERVICE_NAME=recipe-book
GCP_ARTIFACT_REPO=cloud-run-source-deploy

# Backward-compatibility aliases
REGION=us-central1
SERVICE_NAME=recipe-book

# ==============================================================
# GOOGLE OAUTH 2.0 & ACCESS CONTROL
# ==============================================================
# 1. Create Web Application OAuth 2.0 Credentials in Google Cloud Console
# 2. Add authorized origins: http://localhost:8080, http://localhost:5173
# 3. Add authorized redirects: http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET is optional (not required for Google Identity Services 1-click login)
GOOGLE_CLIENT_SECRET=
# Required in production: a random value of at least 32 characters (generate with: openssl rand -hex 32).
# If unset or weak outside production, a random per-process secret is used and sessions reset on restart.
JWT_SECRET=

# Bootstrap administrators (comma-separated emails). Empty means no bootstrap admin.
# Add '*' to also let every signed-in user add/edit/delete recipes ('*' never grants admin).
ALLOWED_EDITOR_EMAILS=admin@yourdomain.com

# Optional Mongo Express GUI (docker compose --profile tools up), bound to localhost only
# MONGO_EXPRESS_USER=admin
# MONGO_EXPRESS_PASSWORD=pass
